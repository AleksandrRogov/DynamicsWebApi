{
    "name": "dynamics-web-api",
    "version": "3.0.0",
    "type": "module",
    "description": "DynamicsWebApi is a Microsoft Dataverse Web API helper library",
    "keywords": [
        "dataverse",
        "d365",
        "dynamics-365",
        "web-api",
        "helper",
        "crm",
        "dynamics-crm",
        "cds",
        "common-data-service",
        "microsoft-dataverse",
        "dynamics-crm-webapi",
        "dynamics-crm-online"
    ],
    "main": "./dist/esm/dynamics-web-api.js",
    "exports": {
        ".": {
            "types": "./dist/dynamics-web-api.d.ts",
            "import": "./dist/esm/dynamics-web-api.js",
            "require": "./dist/cjs/dynamics-web-api.cjs",
            "default": "./dist/cjs/dynamics-web-api.cjs"
        },
        "./browser": {
            "types": "./dist/dynamics-web-api.d.ts",
            "import": "./dist/browser/esm/dynamics-web-api.js",
            "require": "./dist/browser/esm/dynamics-web-api.js",
            "default": "./dist/browser/esm/dynamics-web-api.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*.js",
        "dist/**/*.cjs",
        "dist/**/*.d.ts"
    ],
    "author": {
        "name": "Aleksandr Rogov"
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.0.1",
        "@types/sinon": "^17.0.3",
        "@types/xrm": "^9.0.94",
        "Base64": "^1.3.0",
        "chai": "^6.2.2",
        "copyfiles": "^2.4.1",
        "esbuild": "^0.28.1",
        "glob": "^13.0.6",
        "c8": "^10.1.3",
        "mocha": "^12.0.0",
        "nock": "^14.0.16",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.0",
        "rimraf": "^6.1.3",
        "sinon": "^19.0.5",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "http-proxy-agent": "^9.1.0",
        "https-proxy-agent": "^9.1.0"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "test:clean": "rimraf lib coverage",
        "test:build": "tsc -p tsconfig.build.json",
        "test:mocha": "mocha",
        "test": "run-s test:*",
        "tsc": "tsc -p tsconfig.build.json --noEmit",
        "coverage": "run-s coverage:clean test:build coverage:c8:*",
        "coverage:clean": "rimraf coverage",
        "coverage:c8:test": "c8 --clean --src src --all mocha",
        "coverage:c8:report": "c8 report --reporter=lcov",
        "clean": "rimraf dist lib coverage .nyc_output",
        "off-build:ts": "node ./utils/build.js",
        "build:bundle": "node ./utils/bundle.js",
        "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
        "build": "run-s clean build:*",
        "postbuild": "run-s copyfiles add-banner",
        "copyfiles": "copyfiles --flat ./lib/dynamics-web-api.d.ts ./dist/",
        "add-banner": "node ./utils/add-banner.js",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.js\"",
        "preversion": "npm test",
        "version": "npm run build && git add -A dist",
        "postversion": "git push && git push --tags",
        "release-patch": "npm version patch -m \"Release v%s\"",
        "release-minor": "npm version minor -m \"Release v%s\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AleksandrRogov/DynamicsWebApi.git"
    }
}
